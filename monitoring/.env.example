# Checkly monitoring config. The CLI (checkly.config.ts) actually reads the repo's
# root ../.env — this file just documents the keys. Copy them into ../.env.
#
# Never commit real keys.

# Private Location agent key (starts pl_...). Checkly dashboard ->
# Private Locations -> New. Shown once. Used by the checkly-agent container.
CHECKLY_AGENT_API_KEY=

# Account credentials for `checkly test` / `checkly deploy` (or run `checkly login`).
# Dashboard -> Account Settings -> API Keys / General.
CHECKLY_API_KEY=
CHECKLY_ACCOUNT_ID=

# Private Location slug the checks run in. Leave unset to run from Checkly's
# public locations instead (then MONITOR_TARGET_URL must be publicly reachable).
CHECKLY_PRIVATE_LOCATION=owl-fs-local

# Where the checks send requests. On the compose network the agent resolves the
# service name; for a deployed API set the public URL.
MONITOR_TARGET_URL=http://api:8000
