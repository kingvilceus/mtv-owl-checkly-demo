# Copy to .env for local development: `cp .env.example .env`
# These are throwaway local-only values. Never put real credentials here.

# Postgres (used by the db container and the maintenance connection in seed.py)
POSTGRES_USER=owl
POSTGRES_PASSWORD=owl
POSTGRES_DB=owl
POSTGRES_HOST_PORT=5432

# Application database URL.
#   - inside the compose network the host is `db`
#   - override this (e.g. host `localhost`) to point two checkouts at one database
DATABASE_URL=postgresql://owl:owl@db:5432/owl

# Default port for `make serve` (override with `make serve PORT=xxxx`)
PORT=8000

# Vite dev server -> API base URL (browser-side, so it must be host-reachable)
VITE_API_URL=http://localhost:8000

# --- Checkly monitoring (optional POC — see monitoring/README.md) ---
# Private Location agent key (pl_...), used by the checkly-agent container.
CHECKLY_AGENT_API_KEY=
# Account credentials for `checkly test` / `checkly deploy` (or run `checkly login`).
CHECKLY_API_KEY=
CHECKLY_ACCOUNT_ID=
# Private Location slug the checks run in; unset -> Checkly's public locations.
CHECKLY_PRIVATE_LOCATION=owl-fs-local
# Where the checks send requests (agent-side; use a public URL for a deployed API).
MONITOR_TARGET_URL=http://api:8000
